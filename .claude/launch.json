{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "desktop-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@vault/desktop",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "sandbox-web",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "export PATH=\"$HOME/.local/node/bin:$PATH\"; VAULT_SERVER=http://localhost:8444 pnpm --filter @vault/desktop dev --port 5175"
      ],
      "port": 5175,
      "autoPort": false
    }
  ]
}