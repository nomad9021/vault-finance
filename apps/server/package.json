{
  "name": "@vault/server",
  "version": "0.2.2",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/db && rm -rf dist/db/migrations && cp -r src/db/migrations dist/db/migrations && cp src/modules/mobile/*.png dist/modules/mobile/",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fastify/cors": "^11.4.1",
    "@vault/design-tokens": "workspace:*",
    "@vault/shared": "workspace:*",
    "argon2": "^0.45.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "jose": "^6.2.17",
    "nodemailer": "^10.5.0",
    "openai": "^7.55.0",
    "postgres": "^3.4.5",
    "selfsigned": "^5.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^17.5.0-beta.15",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^5.1.0"
  }
}
