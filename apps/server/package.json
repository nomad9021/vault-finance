{
  "name": "@vault/server",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/db && rm -rf dist/db/migrations && cp -r src/db/migrations dist/db/migrations && cp src/modules/mobile/*.png dist/modules/mobile/",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@fastify/cors": "^11.3.0",
    "@vault/design-tokens": "workspace:*",
    "@vault/shared": "workspace:*",
    "argon2": "^0.41.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "fastify-plugin": "^5.0.1",
    "jose": "^5.9.6",
    "nodemailer": "^6.9.16",
    "openai": "^6.10.0",
    "postgres": "^3.4.5",
    "selfsigned": "^2.4.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^6.4.17",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "^17.5.0-beta.15",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
