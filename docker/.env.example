# Vault Finance — copy to .env and adjust. Every value has a working default.
#
# This configures ONE stack for ONE family. To host several separate families on
# one machine, use docker/multi/familyctl.sh instead — see docs/multi-family.md.

# Postgres credentials (internal to the compose network; change the password
# anyway if this machine has other users).
POSTGRES_USER=vault
POSTGRES_PASSWORD=vault
POSTGRES_DB=vault

# Port the API is published on (HTTPS).
VAULT_PORT=8443

# Where the server finds Ollama. "ollama" is the bundled compose service;
# set a hostname/IP to use an Ollama running elsewhere on your network.
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.1:8b

LOG_LEVEL=info

# Release image tag to run. "latest" tracks the newest published release;
# pin an exact version (e.g. 0.2.0) if you'd rather update deliberately.
VAULT_VERSION=latest

# ── Outbound email (optional) ──────────────────────────────────────────────
# Leave SMTP_HOST blank to disable email entirely (the server still runs).
# With it set, the server sends: a household-confirmed note after setup, a
# heads-up when a new version is available, and member invitations.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Vault Finance <no-reply@example.com>

# Public HTTPS address people use to reach this server. Used to build links in
# emails (invitations, "open the app"). e.g. https://192.168.1.10:8443
APP_PUBLIC_URL=

# Optional: a short feedback survey linked from the welcome email.
SURVEY_URL=

# Daily update check against the project's GitHub releases. Set to false to
# disable (air-gapped servers). UPDATE_OPERATOR_MANAGED=true changes the
# "update available" email to say "contact your admin".
UPDATE_CHECK_ENABLED=true
UPDATE_OPERATOR_MANAGED=false
